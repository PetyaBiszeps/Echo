{
  "name": "echo-messenger",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "shadcn:init": "pnpm dlx shadcn-vue@latest init -c ./packages/client",
    "shadcn:add": "pnpm dlx shadcn-vue@latest add -c ./packages/client",
    "dev": "node scripts/dev.js",
    "dev:studio": "node scripts/dev.js --studio",
    "db:studio": "pnpm --filter @echo/server exec prisma studio",
    "build": "pnpm --filter @echo/shared build && pnpm --filter @echo/server build && pnpm --filter @echo/client build",
    "clean": "pnpm --filter @echo/shared clean && pnpm --filter @echo/server clean && pnpm --filter @echo/client clean",
    "dev:client": "pnpm --filter @echo/client dev",
    "dev:server": "pnpm --filter @echo/server dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "author": "YP00",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
