{
  "name": "echo-messenger",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "pnpm --filter @echo/shared build && pnpm --filter @echo/server build && pnpm --filter @echo/client build",
    "clean": "pnpm --filter @echo/shared clean && pnpm --filter @echo/server clean && pnpm --filter @echo/client clean",
    "dev:client": "pnpm --filter @echo/client dev",
    "dev:server": "pnpm --filter @echo/server dev",
    "lint": "eslint packages --ext .ts,.js,.vue",
    "lint:fix": "eslint packages --ext .ts,.js,.vue --fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vue-eslint-parser": "^10.4.0"
  },
  "author": "YP00",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
