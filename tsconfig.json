{
  "compilerOptions": {
    // Global
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    // Compile options
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    // TS
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // JSX
    "jsx": "preserve",
    "jsxImportSource": "vue",

    // Alias
    "baseUrl": ".",
    "paths": {
      "@echo/shared/*": ["packages/shared/src/*"],
      "@echo/server/*": ["packages/server/src/*"],
      "@echo/client/*": ["packages/client/src/*"]
    },
    "ignoreDeprecations": "6.0"   // ALERT: TypeScript 7.0 will break baseUrl
  },
  "include": [
    "src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue",
    "vite.config.ts", "eslint.config.mjs", "env.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
