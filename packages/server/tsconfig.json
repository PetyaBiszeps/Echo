{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "outDir": "dist",
    "types": ["node"]
  },
  "include": [
    "src",
    "vite.config.mts", "vite.config.ts", "vite.config.mjs", "vite.config.js",
    "vitest.config.ts", "vitest.config.js",
    "src/types/**/*.d.ts"
  ]
}
