{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "rootDir": "../..",
    "paths": {
      "@/*": ["src/*", "src/*.ts", "src/*/index.ts"],
      "@echo/shared": ["../shared/src/index.ts"],
      "@echo/shared/*": ["../shared/src/*"]
    },
    "outDir": "dist",
    "types": ["node"]
  },
  "include": [
    "src",
    "vite.config.mts", "vite.config.ts", "vite.config.mjs", "vite.config.js",
    "prisma.config.ts", "vitest.config.ts", "vitest.config.js",
    "src/types/**/*.d.ts"
  ]
}
